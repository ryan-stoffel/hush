--swiftversion 5.10
--exclude .build,DerivedData,build,**/Generated

--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas always
--trimwhitespace always
--stripunusedargs closure-only
--self remove
--semicolons never
--importgrouping testable-last
--header strip
--ifdef no-indent
--ranges spaced
--operatorfunc spaced
--voidtype void
--patternlet hoist
--elseposition same-line
--guardelse same-line

--disable wrapMultilineStatementBraces,docComments
--enable isEmpty
--enable blankLinesBetweenImports
